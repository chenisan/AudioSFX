{
  "name": "audiosfx",
  "version": "0.1.0",
  "description": "Local, non-commercial video→SFX tool (MMAudio + Sony Woosh). Forked from 13soulMU timeline + ffmpeg render core.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "13soul",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/kill-ports.mjs 6300 6301",
    "dev": "concurrently --kill-others -n \"BE,FE\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch server --ext ts,js --exec \"tsx server/index.ts\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "esbuild server/index.ts --bundle --platform=node --outfile=dist/server/index.js --packages=external",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "preelectron:dev": "node scripts/kill-ports.mjs 6301",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "build:native": "cd native/media-engine && napi build --platform --release",
    "build:native:debug": "cd native/media-engine && napi build --platform"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.99",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "express": "^4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2",
    "js-yaml": "^4",
    "multer": "^1",
    "opencc-js": "^1.3.1",
    "react": "^18",
    "react-dom": "^18",
    "uuid": "^9",
    "zod": "^3.25",
    "zustand": "^4"
  },
  "build": {
    "appId": "com.audiosfx.app",
    "productName": "AudioSFX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      {
        "from": "native/media-engine",
        "to": "native/media-engine",
        "filter": [
          "index.js",
          "index.d.ts",
          "package.json",
          "*.node"
        ]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
        "to": "ffprobe.exe"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "native/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon/icon.ico",
      "uninstallerIcon": "icon/icon.ico"
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@playwright/test": "^1.59.1",
    "@types/cors": "^2",
    "@types/express": "^4",
    "@types/fluent-ffmpeg": "^2",
    "@types/js-yaml": "^4",
    "@types/multer": "^1",
    "@types/node": "^20",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10",
    "concurrently": "^8",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "supertest": "^7.2.2",
    "tailwindcss": "^3",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^4.1.2"
  }
}
