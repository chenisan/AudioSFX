# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Most AI provider API keys (OpenAI / Gemini / Anthropic / Kling / Runway /
# Seedance) are NOT here — they live in `data/settings.json` AES-encrypted by
# `server/utils/secretStore.ts`, set via the in-app Settings modal at first
# run. Only the variables below need to be in `.env`.

# ── AI provider mode ───────────────────────────────────────────────────────
# local = call locally-installed CLI (gemini / claude / codex) via stdio →
#         uses the CLI's own subscription auth, NO API key billed.
#         Detection order: gemini → claude → codex (first available wins).
#         See server/ai/localAgent.ts CANDIDATES.
# api   = call Anthropic API directly via SDK. Requires anthropicKey in
#         data/settings.json (set in Settings modal). Default for packaged
#         Electron builds where users won't have a CLI installed.
AI_PROVIDER=local

# ── Fish Audio TTS ─────────────────────────────────────────────────────────
# TTS provider — used by /api/tts and the timeline TTS panel. Get keys at
# https://fish.audio/. Lives here (not secretStore) because it predates the
# encrypted secret store and migrating now is not worth the churn.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=

# ── Optional overrides ─────────────────────────────────────────────────────

# Port the Express backend listens on. Vite dev server (frontend) is hard-
# coded to 6200 and proxies /api/* here.
# PORT=6201

# Override where projects/<id>/ data lives. Default: <project>/data/
# Useful for tests (point to a tmp dir) or moving the data dir off SSD.
# VIDEO_ENGINE_DATA_DIR=./data

# Override ffmpeg / ffprobe binaries. Default: ffmpeg-static (bundled) +
# system PATH for ffprobe. Set when packaging Electron or when ffmpeg-static
# does not include ffprobe on your platform.
# FFMPEG_PATH=
# FFPROBE_PATH=

# ── Auth / membership (G1) ─────────────────────────────────────────────────
# Random 32-byte hex used to sign session tokens. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Bootstrap admin — used ONCE when the users table is empty (first boot or
# after wiping data/billing.db). Once any user exists these become inert.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Local CLI tuning (rarely needed) ───────────────────────────────────────
# Hard timeout for a single CLI call (default 5 min). Spawned `gemini -p`
# usually returns in 30-180s; raise only if you see legitimate hangs.
# LOCAL_CLI_TIMEOUT_MS=300000

# Early-fail timeout when the CLI emits no output at all (default 60s). Most
# common cause of triggering this is the CLI prompting for OAuth login on
# stdin — fix by running `gemini` (or `claude`) once interactively to log in.
# LOCAL_CLI_FIRST_OUTPUT_MS=60000
